@model ContactUsModel
@{
    ViewData["Title"] = "ContactUs";
    Layout = "_BlogSiteLayout";
}

<div class="row">
    <div class="col-lg-12 col-md-12 col-sm-12 col-xs-12">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="row">
                    <div class="col-sm-12">
                        <div class="text-center">
                            <h2 class="lg-title">Contact form</h2>
                        </div>
                    </div>
                </div>

                <form id="contact-form" class="contact-form" asp-area="" asp-controller="Home" asp-action="ContactUs">
                    <div class="row">
                        <div class="col-md-12">
                            <div class="form-group">
                                <label asp-for="SenderName">Your Name (required)</label>
                                <input class="form-control form-control-name custom-input"
                                       type="text" asp-for="SenderName">
                                <span asp-validation-for="SenderName"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="SenderEmail">Your Email (required)</label>
                                <input class="form-control form-control-email custom-input"type="email" 
                                 asp-for="SenderEmail">
                                 <span asp-validation-for="SenderEmail"></span>
                            </div>

                            <div class="form-group">
                                <label asp-for="Message">Your Message</label>
                                <textarea class="form-control form-control-message custom-input" rows="7" 
                                 asp-for="Message"></textarea>
                                 <span asp-validation-for="Message"></span>
                            </div>

                            <div class="d-flex justify-content-end">
                                <button class="btn btn-brand rounded-pill mt-3" type="submit">
                                    <span><i class="fa-solid fa-paper-plane" style="color: #22281f;"></i></span>
                                </button>
                            </div>
                            
                        </div>
                    </div>
                </form>
            </div>
        </div>

    </div>
</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial"/>
}

