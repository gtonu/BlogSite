@model GetTagsWithPostsModel
@{
    ViewData["Title"] = "Tags";
    Layout = "_ReaderLayout";
}

<div class="content-wrapper bg-white">
    <!-- Main Container aligned to 10 columns for consistency -->
    <div class="container">
        <div class="row justify-content-center pt-5">
            <div class="col-lg-10 col-md-11 col-sm-12">

                <!-- Header Section -->
                <div class="text-center mb-5 pb-5">
                    <h1 class="display-4 font-weight-bold mb-3" style="font-family: 'Playfair Display', serif; color: #292929; letter-spacing: -2px;">
                        Explore Topics
                    </h1>
                    <p class="text-muted lead mb-5" style="font-size: 1.2rem; max-width: 600px; margin-left: auto; margin-right: auto;">
                        Discover stories, thinking, and expertise from writers on any topic.
                    </p>

                    <!-- Prominent Explore Search Bar -->
                    <div class="row justify-content-center">
                        <div class="col-12 col-md-8 col-lg-6">
                            <form asp-controller="Home" asp-action="Categories" method="post" asp-antiforgery="true">
                                <!-- Wrapper acts as the 'border' for both input and button -->
                                <div class="explore-search-wrapper d-flex align-items-center bg-white px-2 py-1 border shadow-sm"
                                     style="border-radius: 50px; border-color: #eee !important; transition: all 0.3s ease; height: 60px;">

                                    <!-- Search Icon -->
                                    <i class="fas fa-search text-muted ml-3 mr-2"></i>

                                    <!-- Input Area -->
                                    <input class="form-control border-0 bg-transparent flex-grow-1"
                                           type="search"
                                           name="searchItem"
                                           id="searchItem"
                                           placeholder="Search for a topic..."
                                           style="box-shadow: none; font-size: 1.05rem; height: 100%;">

                                    <!-- Integrated Search Button -->
                                    <button type="submit" class="btn rounded-pill d-flex align-items-center justify-content-center"
                                            style="background-color: #FF7900; color: white; width: 45px; height: 45px; transition: 0.3s;">
                                        <i class="fas fa-arrow-right"></i>
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Topic Groups -->
                <div class="topic-section mb-5">
                    <h5 class="text-uppercase small font-weight-bold text-muted mb-4 border-bottom pb-2" style="letter-spacing: 1.5px;">
                        Recommended for you
                    </h5>

                    <div class="d-flex flex-wrap">
                        @foreach (var tag in Model.Tags)
                        {
                            <a asp-controller="Home" asp-action="Posts" asp-area="" asp-route-id="@tag.TagName"
                               class="btn btn-light rounded-pill px-4 py-2 m-2 shadow-sm topic-link">
                                @tag.TagName
                            </a>
                        }
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


