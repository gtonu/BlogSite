
@{
    ViewData["Title"] = "AccessDenied";
    Layout = "_AuthenticationLayout";
}

<!-- Access Denied Page for Sneat -->
<div class="container-xxl container-p-y">
    <div class="misc-wrapper d-flex flex-column align-items-center text-center">
        <!-- Error Code -->
        <h2 class="mb-2 mx-2" style="font-size: 6rem; font-weight: 700; color: #696cff;">403</h2>

        <!-- Title and Message -->
        <h4 class="mb-2">Access Denied / Forbidden 🔐</h4>
        <p class="mb-4 mx-2 text-muted">
            Oops! It looks like you don't have permission to access this page.<br>
            Please contact your administrator or head back to safety.
        </p>
        @{
            if(SignInManager.IsSignedIn(User))
            {
                <!-- Sleat-Style CTA Button -->
                <a asp-controller="Blog" asp-action="Index" asp-area="" class="btn btn-primary px-5 py-2 shadow-sm" style="border-radius: 0.5rem;">
                    Back to Home
                </a>
            }
            else
            {
                <a asp-controller="Home" asp-action="Index" asp-area="" class="btn btn-primary px-5 py-2 shadow-sm" style="border-radius: 0.5rem;">
                    Back to Home
                </a>
            }
        }
        

        <!-- Minimalist Illustration (Sneat Asset Path) -->
        <div class="mt-5">
            <img src="~/sneat/assets/img/illustrations/403 Error Forbidden-cuate.png"
                 alt="page-misc-error-light"
                 width="450"
                 class="img-fluid" />
        </div>
    </div>
</div>


