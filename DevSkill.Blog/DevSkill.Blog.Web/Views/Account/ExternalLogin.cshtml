
@model ExternalLoginModel
@{
    ViewData["Title"] = "Register";
    Layout = "_AuthenticationLayout";
}

<div class="card shadow-none">
    <div class="card-body">
        <!-- Logo / Brand Section -->
        <div class="app-brand justify-content-center mb-4 mt-2">
            <a asp-controller="Home" asp-action="Index" class="app-brand-link gap-2">
                <span class="app-brand-logo demo">
                    
                </span>
                <span class="app-brand-text demo text-body fw-bolder text-capitalize">ShareThought</span>
            </a>
        </div>
        <!-- /Logo -->

        <h4 class="mb-2">Link your account 🚀</h4>
        <p class="mb-4">
            Successfully authenticated with <span class="fw-bold text-primary">@Model.ProviderDisplayName</span>.
            Please confirm your email to complete the registration.
        </p>

        <form id="external-login-form" asp-antiforgery="true" asp-area="" asp-action="ExternalLoginConfirmation"
              asp-controller="Account" asp-route-returnUrl="@Model.ReturnUrl" method="post">

            <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small" role="alert"></div>

            <div class="mb-3">
                <label asp-for="Email" class="form-label">Email Address</label>
                <div class="input-group input-group-merge">
                    <span class="input-group-text"><i class="bx bx-envelope"></i></span>
                    <input asp-for="Email" class="form-control" placeholder="name@example.com" autofocus />
                </div>
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <button class="btn btn-primary d-grid w-100 py-2 rounded-pill" type="submit">
                    Finish Registration
                </button>
            </div>
        </form>

        <p class="text-center mt-3">
            <span>Already have an account?</span>
            <a asp-action="Login" asp-controller="Account">
                <span>Sign in instead</span>
            </a>
        </p>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


