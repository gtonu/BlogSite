<!DOCTYPE html>

<html lang="en">

<head>
	<meta charset="utf-8">
	<title>Share Thought - Personal blog</title>
	<meta http-equiv="X-UA-Compatible" content="IE=edge">
	<meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=PT+Serif:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
	<link rel="preconnect" href="https://fonts.googleapis.com">
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
	<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">

	<!-- Font awesome icons -->
	<script src="https://kit.fontawesome.com/c2f8684575.js" crossorigin="anonymous"></script>

	<!-- THEME CSS
	================================================== -->
	<!-- Bootstrap -->
	<link rel="stylesheet" href="~/BlogSite/plugins/bootstrap/css/bootstrap.min.css">
	<!-- Themify -->
	<link rel="stylesheet" href="~/BlogSite/plugins/themify/css/themify-icons.css">
	<link rel="stylesheet" href="~/BlogSite/plugins/slick-carousel/slick-theme.css">
	<link rel="stylesheet" href="~/BlogSite/plugins/slick-carousel/slick.css">
	<!-- Slick Carousel -->
	<link rel="stylesheet" href="~/BlogSite/plugins/owl-carousel/owl.carousel.min.css">
	<link rel="stylesheet" href="~/BlogSite/plugins/owl-carousel/owl.theme.default.min.css">
	<link rel="stylesheet" href="~/BlogSite/plugins/magnific-popup/magnific-popup.css">
	<!-- manin stylesheet -->
	<link rel="stylesheet" href="~/BlogSite/css/style.css">
	<link rel="stylesheet" href="~/BlogSite/css/loaderAnimation.css">
	<link rel="stylesheet" href="~/BlogSite/css/customSyles.css">
	@await RenderSectionAsync("Styles",false);
</head>

<body>

	<div class="sk-loader-overlay">
		<!-- CHANGED: overlay wrapper -->
		<div class="sk-folding-cube">
			<div class="sk-cube1 sk-cube"></div>
			<div class="sk-cube2 sk-cube"></div>
			<div class="sk-cube3 sk-cube"></div>
			<div class="sk-cube4 sk-cube"></div>
		</div>
	</div>

	<header class="header-top bg-grey justify-content-center">
		<div class="container">
			<div class="row align-items-center">
				<div class="col-lg-3">
					<div class="d-flex align-items-center">
						<a asp-area="" asp-controller="Home" asp-action="Index" class="navbar-brand font-weight-bold" style="color: #FF7900; letter-spacing: -1px;">
							<i class="fa-solid fa-feather-pointed mr-2"></i>ShareThought
						</a>
					</div>

				</div>
				<div class="col-lg-4">
					@* <div class="text-right search">
						<div class="search_toggle d-none d-lg-block">
							<div class="input-group">
								<!-- Added -lg for a larger, bolder area -->
								<input type="text"
									   class="form-control border-dark border-right-0 rounded-left-pill"
									   placeholder="enter category e.g: web development"
									   style="border-top-left-radius: 50px; border-bottom-left-radius: 50px;">

								<div class="input-group-append">
									<span class="input-group-text bg-transparent border-dark border-left-0"
										  style="border-top-right-radius: 50px; border-bottom-right-radius: 50px;">
										<i class="ti-search text-dark"></i>
									</span>
								</div>
							</div>

						</div>
					</div> *@
				</div>
				<div class="col-lg-5 text-center col-md-8 col-5">
					<nav class="navbar navbar-expand-lg navigation">
						<button class="navbar-toggler" type="button" data-toggle="collapse" data-target="#navbarContent"
							aria-controls="navbarContent" aria-expanded="false" aria-label="Toggle navigation">
							<span class="ti-menu"></span>
						</button>
						<div class="collapse navbar-collapse" id="navbarContent">
							<ul id="menu" class="menu navbar-nav mx-auto ">
								<li class="nav-item dropdown">
									<a class="nav-link dropdown-toggle" asp-area="" asp-controller="Account" asp-action="Login"
									   asp-route-returnUrl="@Url.Action("Create", "Blog", new { area = ""})" role="button">
										Write
									</a>

								</li>
								<li class="nav-item dropdown">
									<a class="nav-link dropdown-toggle" asp-area="" asp-controller="Account" asp-action="Login"
									 asp-route-returnUrl="@Url.Action("Index", "Blog", new { area = ""})" role="button">
										Log in
									</a>
									
								</li>

								<li class="nav-item d-flex align-items-center ml-lg-3">
									@* <form class="form-inline" asp-area="" asp-controller="Account" asp-action="Login"
										  asp-route-returnUrl="@Url.Action("Index", "BlogArea", new { area = "" })">
										<button type="submit" class="btn btn-brand rounded-pill px-4 py-2 text-light">
											Join Now
										</button>
									</form> *@
									<a asp-area="" asp-controller="Account" asp-action="Register" 
									 asp-route-returnUrl="@Url.Action("Index", "Blog", new { area = "" })"
									 class="btn btn-brand rounded-pill px-4 py-2 text-light">
										Join Now
									</a>
								</li>


							</ul>
						</div>
					</nav>
				</div>

				
			</div>
		</div>
	</header>

	<section class="section-padding pt-4">
		<div class="container">
			
			@RenderBody()
		</div>
	</section>

	<section class="footer-2 section-padding gray-bg pb-5">
		<div class="container">
			

			<div class="footer-btm mt-5 pt-4 border-top">
				<div class="row">
					<div class="col-lg-12">
						<ul class="list-inline footer-socials-2 text-center">
							<li class="list-inline-item"><a asp-controller="Home" asp-action="Privacy" asp-area="">Privacy policy</a></li>
							<li class="list-inline-item">
								<a asp-area="" asp-controller="Home" asp-action="ContactUs">Contact us</a></li>
							<li class="list-inline-item">
								<a asp-area="" asp-controller="Home" asp-action="TermsAndConditions">
									Terms &amp; Conditions
								</a>
							</li>
						</ul>
					</div>
				</div>
				<div class="row justify-content-center">
					<div class="col-lg-6">
						<div class="copyright text-center ">
							@@ copyright all reserved to <a href="https://themefisher.com/">themefisher.com</a>-2019 Distribution
							<a " href=" https://themewagon.com">ThemeWagon.</a></p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>


	<!-- THEME JAVASCRIPT FILES
================================================== -->
	<!-- initialize jQuery Library -->
	<script src="~/BlogSite/plugins/jquery/jquery.js"></script>
	<!-- Bootstrap jQuery -->
	<script src="~/BlogSite/plugins/bootstrap/js/bootstrap.min.js"></script>
	<script src="~/BlogSite/plugins/bootstrap/js/popper.min.js"></script>
	<!-- Owl caeousel -->
	<script src="~/BlogSite/plugins/owl-carousel/owl.carousel.min.js"></script>
	<script src="~/BlogSite/plugins/slick-carousel/slick.min.js"></script>
	<script src="~/BlogSite/plugins/magnific-popup/magnific-popup.js"></script>
	<!-- Instagram Feed Js -->
	<script src="~/BlogSite/plugins/instafeed-js/instafeed.min.js"></script>
	<!-- Google Map -->
	<script src="https://maps.googleapis.com/maps/api/js?key=AIzaSyCC72vZw-6tGqFyRhhg5CkF2fqfILn2Tsw"></script>
	<script src="~/BlogSite/plugins/google-map/gmap.js"></script>
	<!-- main js -->
	<script src="~/BlogSite/js/custom.js"></script>
	<!-- markdown parser (marked.js)-->
	<script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
	<script>
		$(function() {
			let loader = $(".sk-loader-overlay");

			$(window).on('load', function() {
				loader.fadeOut(3000);
			});
		});

	</script>

	@await RenderSectionAsync("Scripts",false);


</body>

</html>
