<div class="card border-0 border-bottom mb-4 rounded-0 w-100">
	<div class="row no-gutters align-items-center">
		<!-- Thumbnail -->
		<div class="col-4 col-md-3">
			<img src="~/path/to/thumbnail.jpg" class="card-img rounded" alt="Thumbnail"
				 style="object-fit: cover; height: 120px; width: 100%;">
		</div>
		<!-- Main Content Area -->
		<div class="col-8 col-md-9">
			<div class="card-body pl-0">
				<h2 class="card-title font-weight-bold h4 text-dark" style="font-family: 'Playfair Display', serif;">
					Card title
				</h2>
				<p class="card-text text-muted d-none d-md-block">
					With supporting text below as a natural lead-in to additional content.
				</p>
				<div class="d-flex align-items-center mt-3">
					<span class="text-muted small">Feb 10 · 5 min read</span>
					<a href="#" class="btn btn-link btn-sm text-primary ml-auto p-0">View Story</a>
				</div>
			</div>
		</div>

		
	</div>
</div>

