
@{
    ViewData["Title"] = "Index";
}

@section Styles
{
    <link rel="stylesheet" href="https://cdn.datatables.net/2.3.6/css/dataTables.dataTables.css" />
}


<!-- Content -->
<div class="container-xxl flex-grow-1 container-p-y">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb breadcrumb-style1">
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
            </li>
            <li class="breadcrumb-item">
                <a asp-area="Admin" asp-controller="TermsAndConditions" asp-action="Index">Terms & Conditions</a>
            </li>
            <li class="breadcrumb-item active">Dashboard</li>
        </ol>
    </nav>
    <!-- Header Action Bar -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="fw-bold mb-0">
            <span class="text-muted fw-light">Terms &amp; Conditions</span>
        </h4>
        <button class="btn rounded-pill btn-outline-secondary"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#collapseExample"
                aria-expanded="false"
                aria-controls="collapseExample">
            <i class="bx bx-filter-alt me-1"></i> Filter
        </button>
    </div>
    <!-- /buttons section -->
    <!-- Collapsed content block for advanced search form -->

    <!-- /Collapsed content -->
    <!-- Modal -->
    <partial name="_DeleteModalPartial" />
    <!-- /Modal -->
    <!-- begin::Datatable section -->
    <!-- Main Content Card -->
    <div class="card shadow-sm border-0">
        <!-- Professional Eye-catchy Header -->
        <div class="card-header d-flex justify-content-between align-items-center bg-primary py-3">
            <h5 class="card-title mb-0 text-white">
                <i class="bx bx-shield-quarter me-2"></i> Compliance Documents
            </h5>
            <span class="badge bg-white text-primary rounded-pill">Official Registry</span>
        </div>

        <div class="card-body p-0">
            <!-- Keep your form for logical consistency -->
            <form asp-antiforgery="true" asp-area="Admin" asp-controller="Blog" asp-action="Create" enctype="multipart/form-data">
                <div class="table-responsive text-nowrap">
                    <table id="termsAndConditions" class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase fw-bold small text-muted">Version</th>
                                <th class="py-3 text-uppercase fw-bold small text-muted">Content Preview</th>
                                <th class="pe-4 py-3 text-uppercase fw-bold small text-muted text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </thead>
                        <tbody class="table-border-bottom-0">
                            <!-- DataTables Populated Here -->
                        </tbody>
                        <tfoot class="table-light">
                            <tr>
                                <th class="ps-4 py-3 text-uppercase fw-bold small text-muted">Version</th>
                                <th class="py-3 text-uppercase fw-bold small text-muted">Content Preview</th>
                                <th class="pe-4 py-3 text-uppercase fw-bold small text-muted text-center" style="width: 150px;">Actions</th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </form>
        </div>
        <!-- Bottom Accent -->
        <div class="card-footer border-top-0 py-2 bg-light opacity-50"></div>
    </div>
    <!-- end::Datatable section -->
</div>

<!-- / Content -->
