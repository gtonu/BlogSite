@model CreateTermsAndConditionsModel

@{
    ViewData["Title"] = "Create";
}
@section Styles
{
    <link rel="stylesheet"
          type="text/css"
          href="https://unpkg.com/tiny-markdown-editor/dist/tiny-mde.min.css" />
}


<div class="container-xxl flex-grow-1 container-p-y">
    <div class="row">
        <div class="col-lg-12 mb-4 order-0">
            <div class="container text-center">
                <div class="row align-items-center">
                    <div class="col-md-6">
                    </div>
                    <div class="col-md-2">
                    </div>
                    <div class="col-md-4">
                        <nav aria-label="breadcrumb">
                            <!-- Basic Breadcrumb -->
                            <ol class="breadcrumb">
                                <li class="breadcrumb-item">
                                    <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a asp-area="Admin" asp-controller="Blog" asp-action="Index">Blog</a>
                                </li>
                                <li class="breadcrumb-item">
                                    <a asp-area="Admin" asp-controller="Blog" asp-action="Create">Create</a>
                                </li>
                            </ol>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row g-4">
            <!--begin::Col-->
            <!--end::Col-->
            <!--begin::Col-->
            <div class="col-md">
                <!--begin::Create Blog form-->
                <div class="card card-primary card-outline mb-4">
                    <div class="bg-secondary p-1 rounded-top w-100"></div>
                    <!--begin::Header-->
                    <div class="card-header">
                        <div class="card-title">
                            <h1>
                                <i class="menu-icon fa-solid fa-pen-nib fa-lg"></i>
                                <strong>
                                    Terms &amp; Conditions
                                </strong>
                            </h1>
                        </div>
                    </div>
                    <!--end::Header-->
                    <!--begin::Form-->
                    <form asp-antiforgery="true" asp-area="Admin" asp-controller="TermsAndConditions"
                          asp-action="Create" enctype="multipart/form-data" method="post">
                        <!--begin::Body-->
                        <div asp-validation-summary="All" class="bg-warning"></div>
                        <div class="card-body">
                            <div class="row">
                                <div class="form-floating col-md-3 mb-3">
                                    <input type="text" class="form-control" id="floatingInput"
                                           placeholder="e.g v1.0.1" asp-for="Version">
                                    <label for="floatingInput" class="offset-md-1" asp-for="Version">Version</label>
                                    <span asp-validation-for="Version" class="text-danger"></span>
                                </div>
                            </div>

                            <div>
                                <label class="form-label">What's on your mind?</label>
                            </div>

                            <div class="mb-3">
                                <div id="toolbar">
                                    <textarea id="editor" class="form-control editor-height" asp-for="Content">
                                        
                                    </textarea>
                                </div>
                                <span asp-validation-for="Content" class="text-danger"></span>
                            </div>

                        </div>
                        <!--end::Body-->
                        <!--begin::Footer-->
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary">Create</button>
                        </div>
                        <!--end::Footer-->
                    </form>
                    <!--end::Create Blog form-->
                    <div class="bg-secondary p-1 rounded-bottom w-100"></div>
                </div>
                <!--end::Quick Example-->
            </div>
            <!--end::Col-->
        </div>
        <!--end::Row-->
    </div>
</div>





@section Scripts
{
    <script src="https://unpkg.com/tiny-markdown-editor/dist/tiny-mde.min.js"></script>
    
    <script>
        var tinymde = new TinyMDE.Editor({textarea: "editor"});
        var toolbar = new TinyMDE.CommandBar({
            element: "toolbar",
            editor: tinymde,
            commands:['bold', 'italic', 'strikethrough', '|', 'code', '|', 'h1', 'h2', '|', 'ul', 'ol', '|', 
            'blockquote', 'hr', '|', 'insertLink', 'insertImage']
        });

        
    </script>
    
    <partial name="_ValidationScriptsPartial" />
}



