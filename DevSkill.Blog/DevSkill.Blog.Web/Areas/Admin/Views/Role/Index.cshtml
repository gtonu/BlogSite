@section Scripts
{
    <script src="https://cdn.datatables.net/2.3.6/js/dataTables.js"></script>
    <script>
        $(function()
        {
            $("#roles").DataTable({
                processing:true,
                serverSide:true,
                responsive:true,
                lengthChange:true,
                autoWidth:false,
                searching:false,
                ajax:{
                    url:"/Admin/Role/GetRoles",
                    type:"POST",
                    contentType:"application/json",
                    dataType:"json",
                    data:function(d){
                        d.SearchItem = {
                            Name: $("#SearchItem_Name").val()
                        };
                        return JSON.stringify(d);
                    },
                },
                columnDefs:[
                    {
                        orderable: false,
                        targets: 1,
                        render: function(data, type, row){
                            return `<button type="submit" class="btn rounded-pill btn-dark btn-sm edit-bs-modal" data-id='${data}' value='${data}'>
                                        <i class="fa fa-pencil"></i> Edit
                                    </button>
                                    <button type="submit" class="btn rounded-pill btn-warning btn-sm" onclick="window.location.href='/admin/product/edit/${data}'" value='${data}'>
                                        <i class="fa-regular fa-eye" style="color: #000000;"></i> Manage Permissions
                                    </button>
                                    <button type="submit" class="btn rounded-pill btn-danger btn-sm show-bs-modal" data-id='${data}' value='${data}'>
                                        <i class="fa fa-trash"></i> Delete
                                    </button>`;
                        }
                    }
                ]
            });

            $("#roles").on("click",".edit-bs-modal",function(){
                //these two lines clears the previous shown Error message if any
                $("#roleName-validation").text("");
                $("#edit-name").removeClass("is-invalid");

                let id = $(this).data("id");
                $.getJSON(`/admin/role/edit/${id}`, function (data) {
                    $("#edit-id").val(data.id);
                    $("#edit-name").val(data.name);
                    $("#editModal").modal('show');
                });

            });

            function validateRoleName(){
                let roleNameInput = $("#edit-name");
                let errorSpan = $("#roleName-validation");
                let nameInput = roleNameInput.val();

                //clear the previous shown Error message if any
                errorSpan.text("");
                roleNameInput.removeClass("is-invalid");

                //checking if roleName is empty or not
                if(nameInput.length === 0){
                    errorSpan.text("RoleName is required");
                    roleNameInput.addClass("is-invalid");
                    roleNameInput.focus();
                    return false;
                }
                return true;
            }

            $(document).on("click", "#save-button", function () {
              //client side validation
              if(!validateRoleName()){
                  return;
              }

              const form = $("#edit-form");
                $.ajax({
                    url: "/admin/role/edit",
                    type: "POST",
                    data: form.serialize(),
                    success: function () {
                        $("#editModal").modal("hide");
                        $("#roles").DataTable().ajax.reload(null, false);
                    }
                });
            });

            $("#roles").on("click",".show-bs-modal",function(){
                let id = $(this).data("id");
                let deleteModal = $("#deleteModal");
                deleteModal.find('.modal-body p').text(`Do you really want to delete this role?`);
                $("#delete-id").val(id);
                $("#delete-form").attr("action","/admin/role/delete");
                deleteModal.modal('show');
            });

            $("#delete-button").click(function()
            {
                $("#delete-form").submit();
            });

            $("#filterButton").click(function(){
                $("#roles").DataTable().ajax.reload(null,false);
            });

        });
    </script>
}



