@section Scripts
{
    <script src="https://cdn.datatables.net/2.3.6/js/dataTables.js"></script>
    <script>
        $(function()
        {
            $("#users").DataTable({
                processing:true,
                serverSide:true,
                responsive:true,
                lengthChange:true,
                autoWidth:false,
                searching:false,
                ajax:{
                    url:"/Admin/User/GetUsers",
                    type:"POST",
                    contentType:"application/json",
                    dataType:"json",
                    data:function(d){
                        d.SearchItem = {
                            UserName: $("#SearchItem_UserName").val(),
                            Email: $("#SearchItem_Email").val(),
                            EmailConfirmed: $("input[name='SearchItem.EmailConfirmed']:checked").length === 0 ? null :
                                            $("input[name='SearchItem.EmailConfirmed']:checked").val() === "True"
                        };
                        return JSON.stringify(d);


                    },
                },
                columnDefs:[
                    {
                        targets: 2,
                        render: function(data, type, row){
                            if(data == "True")
                                return `<span class="badge rounded-pill bg-success">Yes</span>`;
                            else
                                return `<span class="badge rounded-pill bg-danger">No</span>`;
                        }
                    },
                    {
                        targets:4,
                        orderable:false,
                        render:function(data,type,row){
                            console.log(data);
                            return `<a class="dropdown-item d-flex align-items-center py-2 view-blog-btn" href="${data}" data-id='${data}'>
                                        ${row[0]}
                                    </a>`
                        }
                    },
                    {
                        orderable: false,
                        targets: 5,
                        render: function(data, type, row){
                            return `
                                    <button type="submit" class="btn rounded-pill btn-warning btn-sm" onclick="window.location.href='/admin/user/assignrole/${data}'" value='${data}'>
                                        <i class="fa-regular fa-eye" style="color: #000000;"></i> Assign role
                                    </button>
                                    `;
                        }
                    }
                ]
            });

            // $(document).on("click",".show-bs-modal",function(){
            //     let id = $(this).data("id");
            //     let isSuspended = $(this).data('suspended');
            //     let suspendModal = $("#suspendModal");
            //     if(isSuspended)
            //     {
            //         suspendModal.find('.modal-body p').text(`Do you really want to unsuspend this blog?`);
            //     }
            //     else
            //     {
            //         suspendModal.find('.modal-body p').text(`Do you really want to suspend this blog?`);
            //     }
                
            //     $("#suspend-id").val(id);
            //     suspendModal.modal('show');
            // });

            // $('#suspend-button').click(function(){
            //     let isSuspended = ()
            // });

            

            $("#filterButton").click(function(){
                $("#users").DataTable().ajax.reload(null,false);
            });

        });
    </script>
}